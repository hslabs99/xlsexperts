# Copy relevant values into `.env.local` for local development.
# Do not commit real secrets. Never prefix SendGrid credentials with NEXT_PUBLIC_.
#
# Real values must be configured in TWO places:
#   1. Developer local: `.env.local` (gitignored)
#   2. Deployed app: hosting platform environment / secret settings (e.g. Vercel)

# --- SendGrid (Mail Send) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Inbox that receives contact-form notifications (falls back to SENDGRID_FROM_EMAIL)
CONTACT_NOTIFY_EMAIL=

# Optional: recipient for POST /api/dev/send-test-email (development only)
SENDGRID_TEST_RECIPIENT=
