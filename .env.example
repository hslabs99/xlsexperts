# Copy relevant values into `.env.local` for local development.
# Do not commit real secrets. Never prefix SendGrid credentials with NEXT_PUBLIC_.
#
# Real values must be configured in TWO places:
#   1. Developer local: `.env.local` (gitignored)
#   2. Deployed app: Firebase App Hosting → Backend → Settings → Environment
#
# App Hosting needs ALL of the vars below (Firebase public + SendGrid).
# Without NEXT_PUBLIC_FIREBASE_* (especially the API key + project id),
# the app cannot locate or access the Firebase datastore from the cloud.

# --- Firebase (also required on App Hosting Environment) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- SendGrid (Mail Send) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Inbox that receives contact-form notifications (falls back to SENDGRID_FROM_EMAIL)
CONTACT_NOTIFY_EMAIL=

# Optional: recipient for POST /api/dev/send-test-email (development only)
SENDGRID_TEST_RECIPIENT=

# Optional: HMAC secret for mailing unsubscribe links (falls back to SENDGRID_API_KEY)
MAILINGS_UNSUBSCRIBE_SECRET=

# Optional: public site origin for unsubscribe links in campaign emails
# (defaults to https://www.xlsexperts.co.nz)
NEXT_PUBLIC_SITE_URL=

# --- OpenAI (admin blog + case-study AI draft / image generation) ---
# Server-only — never prefix with NEXT_PUBLIC_.
# Also configure in Firebase App Hosting → Backend → Settings → Environment.
# IMPORTANT: After adding or changing OPENAI_API_KEY in the Firebase console,
# create a new App Hosting rollout/deploy. Console env changes do not apply
# to the currently running revision until you redeploy.
OPENAI_API_KEY=
